# Copy to llm_secrets.env and fill in real values. Never commit llm_secrets.env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-oss-20b
# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=https://npcnarrator.com
OPENROUTER_APP_TITLE=NPC Narrator
# Auto-fall back to local llama when credit usage reaches this fraction (0.0–1.0)
OPENROUTER_CREDIT_FALLBACK_RATIO=0.8
LOCAL_LLM_URL=
