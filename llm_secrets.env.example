# Copy to llm_secrets.env and fill in real values. Never commit llm_secrets.env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-oss-20b
# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=https://npcnarrator.com
OPENROUTER_APP_TITLE=NPC Narrator
# STT also uses OPENROUTER_API_KEY via POST /api/v1/audio/transcriptions.
# Model selection / attempt hierarchy: Admin STT UI (or middleware /stt/select).
# Bootstrap knobs (optional): STT_PROVIDER_MODE, STT_MODEL_ID, STT_TIMEOUT_SECONDS
# (see game_api.env.example).
# Auto-fall back to local llama when credit usage reaches this fraction (0.0–1.0)
OPENROUTER_CREDIT_FALLBACK_RATIO=0.8
# Required for 80% fallback when /key reports limit: null (typical API keys).
# Set to total USD credits purchased on the OpenRouter account.
OPENROUTER_CREDIT_BUDGET_USD=
# Optional: management key for GET /credits (regular OPENROUTER_API_KEY cannot call it)
OPENROUTER_MANAGEMENT_API_KEY=
LOCAL_LLM_URL=
# Optional multi-stage AI module import model overrides (OpenRouter model ids or catalog keys).
# Empty → inherit CONTENT_CREATION_LLM_MODEL_ID / content_creation purpose.
# IMPORT_DISCOVERY_MODEL=
# IMPORT_CAMPAIGN_MODEL=
# IMPORT_LOCATION_MODEL=
# IMPORT_NPC_MODEL=
# IMPORT_REPAIR_MODEL=
# IMPORT_MAX_SCHEMA_RETRIES=2
# IMPORT_MAX_REPAIR_ATTEMPTS=2
# IMPORT_LOCATION_BATCH_SIZE=1
# IMPORT_NPC_BATCH_SIZE=1

