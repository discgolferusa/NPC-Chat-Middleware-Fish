# Copy to game_api.env (same folder as server.py). Never commit game_api.env.
# Shell environment variables override these values if both are set.
# For GAME_API_* keys, this file wins over a stale shell export.

# Local Funnel/dev: keep 127.0.0.1. Docker Compose sets 0.0.0.0 via container env.
GAME_API_HOST=127.0.0.1
GAME_API_PORT=5000
GAME_API_KEY=replace-with-long-random-secret
REQUIRE_GAME_API_KEY=true

# Optional: Piper voice scan root (defaults to ../Voices next to this repo).
# Also used by GET /voices/attribution (MODEL_CARD credits).
# VOICES_DIR=C:\AI\Voices
# Docker: VOICES_DIR=/voices

# Optional: Piper CLI path. When unset, uses PATH then legacy Windows:
#   C:\AI\npc-server\.venv\Scripts\piper.exe
# Docker: usually omit (piper-tts on PATH) or set PIPER_EXE=/usr/local/bin/piper
# PIPER_EXE=

# Optional: in-process Piper (default). Set PIPER_USE_SUBPROCESS=1 to spawn piper CLI per clip.
# PIPER_USE_SUBPROCESS=
# Optional: GPU for in-process Piper (requires onnxruntime-gpu).
# PIPER_USE_CUDA=
# Optional: max in-process Piper replicas across registered ONNX models (default 10).
# Split proportionally by each model's num_speakers (from *.onnx.json).
# PIPER_POOL_SLOTS=10

# --- Memory / DM persistence (MySQL for production) ---
# When MEMORY_MYSQL_HOST is set, NPC memory + DM tables use MySQL.
# When unset, falls back to SQLite at MEMORY_DB (local tests / quick dev).
#
# MEMORY_MYSQL_HOST=127.0.0.1
# MEMORY_MYSQL_PORT=3306
# MEMORY_MYSQL_DATABASE=npc_middleware
# MEMORY_MYSQL_USER=npc_middleware
# MEMORY_MYSQL_PASSWORD=change-me
# MEMORY_MYSQL_CHARSET=utf8mb4
#
# SQLite fallback (ignored when MEMORY_MYSQL_HOST is set):
# MEMORY_DB=
