# Copy to game_api.env (same folder as server.py). Never commit game_api.env.
# Shell environment variables override these values if both are set.

GAME_API_HOST=127.0.0.1
GAME_API_PORT=5000
GAME_API_KEY=replace-with-long-random-secret
REQUIRE_GAME_API_KEY=true
# Optional: override Piper voice scan root (defaults to ../Voices next to this repo).
# VOICES_DIR=C:\AI\Voices
