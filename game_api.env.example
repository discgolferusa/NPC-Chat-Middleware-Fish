# Copy to game_api.env (same folder as server.py). Never commit game_api.env.
# Shell environment variables override these values if both are set.
# For GAME_API_* keys, this file wins over a stale shell export.

# Local Funnel/dev: keep 127.0.0.1. Docker Compose sets 0.0.0.0 via container env.
GAME_API_HOST=127.0.0.1
GAME_API_PORT=5000
GAME_API_KEY=replace-with-long-random-secret
REQUIRE_GAME_API_KEY=true

# Optional: Piper voice scan root (defaults to ../Voices next to this repo).
# Also used by GET /voices/attribution (MODEL_CARD credits).
# VOICES_DIR=C:\AI\Voices
# Docker: VOICES_DIR=/voices

# Optional: Piper CLI path. When unset, uses PATH then legacy Windows:
#   C:\AI\npc-server\.venv\Scripts\piper.exe
# Docker: usually omit (piper-tts on PATH) or set PIPER_EXE=/usr/local/bin/piper
# PIPER_EXE=

# Optional: in-process Piper (default). Set PIPER_USE_SUBPROCESS=1 to spawn piper CLI per clip.
# PIPER_USE_SUBPROCESS=
# Optional: GPU for in-process Piper (requires onnxruntime-gpu).
# PIPER_USE_CUDA=
# Optional: max in-process Piper replicas across registered ONNX models (default 10).
# Split proportionally by each model's num_speakers (from *.onnx.json).
# PIPER_POOL_SLOTS=10
# Optional: ONNX Runtime intra-op threads per Piper InferenceSession.
# Unset or 0 = stock Piper/ORT automatic threading (production default).
# Try 1–2 under multi-replica concurrency to reduce CPU oversubscription.
# PIPER_ONNX_INTRA_OP_THREADS=0

# --- Memory / DM persistence (MySQL for production) ---
# When MEMORY_MYSQL_HOST is set, NPC memory + DM tables use MySQL.
# When unset, falls back to SQLite at MEMORY_DB (local tests / quick dev).
#
# MEMORY_MYSQL_HOST=127.0.0.1
# MEMORY_MYSQL_PORT=3306
# MEMORY_MYSQL_DATABASE=npc_middleware
# MEMORY_MYSQL_USER=npc_middleware
# MEMORY_MYSQL_PASSWORD=change-me
# MEMORY_MYSQL_CHARSET=utf8mb4
#
# SQLite fallback (ignored when MEMORY_MYSQL_HOST is set):
# MEMORY_DB=

# --- Speech-to-text (OpenRouter hierarchy; day-to-day selection via Admin STT UI) ---
# Provider mode: local | openrouter | openrouter_with_local_fallback
# STT_PROVIDER_MODE=openrouter_with_local_fallback
# Optional bootstrap primary catalog id when stt_runtime_config.json is missing:
# STT_MODEL_ID=openrouter-assemblyai-universal-3-5-pro
# Per-attempt OpenRouter HTTP timeout (default 10s). Must stay below the chain budget.
# STT_TIMEOUT_SECONDS=10
# STT_MAX_RETRIES=0
# Cap how many OpenRouter models are tried before local fallback (default 2).
# STT_MAX_OPENROUTER_ATTEMPTS=2
# Soft wall-clock budget for the whole STT hierarchy (default 20s).
# STT_CHAIN_BUDGET_SECONDS=20
# Seconds reserved for local Whisper so OpenRouter timeouts cannot skip it (default 6).
# STT_LOCAL_RESERVE_SECONDS=6
# After auth failure, skip OpenRouter for this many seconds (default 60). Credits use STT_ONLINE_COOLDOWN_SECONDS.
# STT_AUTH_COOLDOWN_SECONDS=60
# After credits failure, skip OpenRouter for this many seconds (default 300). Shared across the process (one OpenRouter key).
# STT_ONLINE_COOLDOWN_SECONDS=300
# STT_ENABLE_CONTEXT=true
# STT_ENABLE_KEYTERMS=true
# STT_LANGUAGE=en
# Mutating /stt/* requires X-NPCNarrator-Admin from the Yaml Editor admin proxy (default on).
# STT_REQUIRE_ADMIN_HEADER=true
# Uses OPENROUTER_API_KEY from llm_secrets.env / process env (same key as LLM).
